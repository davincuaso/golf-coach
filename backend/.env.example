# Backend bearer token. Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
GOLF_API_TOKEN=replace-with-a-random-token-at-least-24-characters
GOLF_CORS_ORIGINS=["http://localhost:3000"]
GOLF_POSE_WEIGHTS=models/yolov8n-pose.pt
# Optional single-class YOLOv8 ONNX model. The pinned downloader's default file is detected automatically.
# GOLF_BALL_WEIGHTS=models/golf-ball-yolov8n.onnx
# Custom exports must declare output units; the pinned model's normalized units are recognized by hash.
# GOLF_BALL_COORDINATE_UNITS=normalized
GOLF_POSE_DEVICE=cpu
GOLF_POSE_IMAGE_SIZE=960
GOLF_FILTER_CUTOFF_HZ=8
GOLF_MAX_VIDEO_BYTES=262144000
GOLF_WORKER_TIMEOUT_SECONDS=180
GOLF_WORKER_MEMORY_MB=8192
GOLF_MAX_CONCURRENT_ANALYSES=1

# Optional private Supabase storage; all authorized requests share this tenant/prefix.
# GOLF_SUPABASE_URL=https://your-project.supabase.co
# GOLF_SUPABASE_SERVICE_KEY=your-server-only-service-key
GOLF_STORAGE_BUCKET=swings
GOLF_STORAGE_PREFIX=swings

# Coaching prompts are generated locally. No AI provider credentials are needed.
