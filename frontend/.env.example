# Run npm run setup:local after initializing backend/.env.
# These are server-only. Never add NEXT_PUBLIC_ to credentials.
GOLF_BACKEND_URL=http://127.0.0.1:8000
GOLF_API_TOKEN=copy-the-token-from-your-backend-env
GOLF_MAX_VIDEO_BYTES=104857600
GOLF_REQUEST_TIMEOUT_MS=300000

# Production requires workspace HTTP Basic auth. Use HTTPS.
# Local next dev on localhost/127.0.0.1 bypasses this workspace password.
GOLF_WEB_USERNAME=coach
# GOLF_WEB_PASSWORD=choose-a-unique-password-at-least-16-characters
# GOLF_FRONTEND_ORIGIN=https://your-golf-coach-domain.example

# Coaching prompts are generated locally. No AI provider credentials are needed.
